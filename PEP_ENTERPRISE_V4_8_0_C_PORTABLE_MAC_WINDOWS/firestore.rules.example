// LEGACY DEVELOPMENT EXAMPLE — DO NOT DEPLOY IN PRODUCTION.
// Use firestore.rules.candidate only for review in V4.6.0-B; real deployment is reserved for V4.6.0-F.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
