rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PEP V4.7.4 — PRODUCTION SECURITY RULES
    // Firebase Authentication + Custom Claims + default deny.
    function signedIn() { return request.auth != null; }
    function role() {
      return !signedIn() ? null :
        (request.auth.token.role != null ? request.auth.token.role : request.auth.token.pepRole);
    }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.securityAdmin == true ||
        role() == 'ADMINISTRADOR'
      );
    }
    function can(permission) {
      return signedIn() && (
        isAdmin() ||
        (request.auth.token.permissions is list && request.auth.token.permissions.hasAny([permission]))
      );
    }

    // Entidades cloud autoritativas.
    match /{collection}/{docId} {
      allow read: if
          (collection == 'pep-v4_samples' && can('samples.read')) ||
          (collection == 'pep-v4_laboratory' && can('laboratory.read')) ||
          (collection == 'pep-v4_reports' && can('reports.read')) ||
          (collection == 'pep-v4_billing' && can('billing.read')) ||
          (collection == 'pep-v4_receivables' && can('receivables.read')) ||
          (collection == 'pep-v4_clients' && can('clients.read')) ||
          (collection == 'pep-v4_catalogs' && can('catalogs.read'));
      allow create, update, delete: if
          (collection == 'pep-v4_samples' && can('samples.write')) ||
          (collection == 'pep-v4_laboratory' && can('laboratory.write')) ||
          (collection == 'pep-v4_reports' && can('reports.write')) ||
          (collection == 'pep-v4_billing' && can('billing.write')) ||
          (collection == 'pep-v4_receivables' && can('receivables.write')) ||
          (collection == 'pep-v4_clients' && can('clients.write')) ||
          (collection == 'pep-v4_catalogs' && can('catalogs.write'));
    }

    // Change streams usados por Live Sync.
    match /{collection}/{changeId} {
      allow read: if
          (collection == 'pep-v4_changes_samples' && can('samples.read')) ||
          (collection == 'pep-v4_changes_laboratory' && can('laboratory.read')) ||
          (collection == 'pep-v4_changes_reports' && can('reports.read')) ||
          (collection == 'pep-v4_changes_billing' && can('billing.read')) ||
          (collection == 'pep-v4_changes_receivables' && can('receivables.read')) ||
          (collection == 'pep-v4_changes_clients' && can('clients.read')) ||
          (collection == 'pep-v4_changes_catalogs' && can('catalogs.read'));
      allow create, update, delete: if
          (collection == 'pep-v4_changes_samples' && can('samples.write')) ||
          (collection == 'pep-v4_changes_laboratory' && can('laboratory.write')) ||
          (collection == 'pep-v4_changes_reports' && can('reports.write')) ||
          (collection == 'pep-v4_changes_billing' && can('billing.write')) ||
          (collection == 'pep-v4_changes_receivables' && can('receivables.write')) ||
          (collection == 'pep-v4_changes_clients' && can('clients.write')) ||
          (collection == 'pep-v4_changes_catalogs' && can('catalogs.write'));
    }

    // El manifiesto de Seed/Bootstrap debe poder leerse tras un login válido.
    // Solo seguridad administrativa puede modificarlo.
    match /pep-v4_system/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if can('security.admin');
    }

    // Diagnóstico de lectura disponible para sesión autenticada; escritura solo admin.
    match /pep-v4_diagnostics/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if can('security.admin');
    }

    // Todo lo no declarado queda denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
